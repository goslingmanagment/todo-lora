# Local development environment variables.
# Copy to .env.local for `pnpm dev` and CLI scripts.

# Postgres
DATABASE_URL=postgres://todo_lora:todo_lora_dev@127.0.0.1:5433/todo_lora

# Better-Auth
# Generate a fresh secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-fresh-random-string-at-least-32-bytes
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MinIO (S3-compatible)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=todo_lora
MINIO_SECRET_KEY=todo_lora_dev_secret
MINIO_BUCKET=todo-lora-attachments
# Public endpoint that the browser uses to GET/PUT presigned URLs.
# Same as MINIO_ENDPOINT in local dev.
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# App config
APP_TIMEZONE=Europe/Moscow
NODE_ENV=development
LOG_LEVEL=info
