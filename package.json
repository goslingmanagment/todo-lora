{
  "name": "todo-lora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:demo:clear": "tsx scripts/seed.ts --clear-demo",
    "db:old-data:clear": "tsx scripts/old-data-clear.ts --yes",
    "db:studio": "drizzle-kit studio",
    "user:add": "tsx scripts/user-add.ts",
    "user:rotate-code": "tsx scripts/user-rotate.ts",
    "user:remove": "tsx scripts/user-remove.ts",
    "user:purge": "tsx scripts/user-purge.ts",
    "user:list": "tsx scripts/user-list.ts",
    "minio:bootstrap": "tsx scripts/minio-bootstrap.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.5",
    "minio": "^8.0.5",
    "next": "^15.1.5",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
